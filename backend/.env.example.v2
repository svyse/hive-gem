# Drop-in backend .env for stable split-mode use:
# - live QA / code: smaller local model on CPU/RAM
# - local LoRA training: model-specific adapters (default training target: Qwen2.5-Coder-1.5B-Instruct)

# ------------------------------
# LLM backend selection
# ------------------------------
LLM_BACKEND=local

# Optional hosted providers (leave blank unless you want them as backup)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_FALLBACK_MODEL=gpt-4.1
OPENAI_INSUFFICIENT_QUOTA_COOLDOWN_S=900

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_S=1.5
GEMINI_RETRY_MAX_BACKOFF_S=8

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_FALLBACK_MODEL=claude-3-5-haiku-latest
CLAUDE_MAX_TOKENS=1024
LLM_ERROR_BODY_LOG_CHARS=1200

# ------------------------------
# Local live model (GPU-preferred, OOM-safe)
# ------------------------------
# Smaller live model so local Q&A/code does not hang the machine.
LOCAL_LLM_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
LOCAL_LLM_DEVICE=auto
LOCAL_LLM_CONCURRENCY=1
LOCAL_LLM_MAX_NEW_TOKENS=384
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_TOP_P=0.95
LOCAL_LLM_TOP_K=40
LOCAL_LLM_REPETITION_PENALTY=1.05
LOCAL_LLM_LOAD_IN_4BIT=true
LOCAL_LLM_TRUST_REMOTE_CODE=false
LOCAL_LLM_TIMEOUT_S=90
LOCAL_LLM_INITIAL_TIMEOUT_S=300
HF_HOME=~/.cache/huggingface
# HF_TOKEN=...
LOCAL_LLM_ADAPTER_DIR=~/.agentic_hive_studio/local_llm/adapters/latest

# Prefer the RTX 3060/largest CUDA GPU, with CPU offload if VRAM is tight.
LOCAL_LLM_PREFER_LARGEST_GPU=true
LOCAL_LLM_OFFLOAD_IF_OOM=true
LOCAL_LLM_MAX_GPU_MB=10240
LOCAL_LLM_MAX_CPU_MB=24000

# ------------------------------
# Training model (GPU only)
# ------------------------------
LOCAL_TRAINING_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
LOCAL_TRAINING_ENABLED=true
LOCAL_TRAINING_AUTOSTART=false
LOCAL_TRAINING_POLL_S=900
LOCAL_TRAINING_MIN_NEW_PAIRS=20
LOCAL_TRAINING_MAX_PAIRS=1200
LOCAL_TRAINING_DEVICE=auto
LOCAL_TRAINING_TRUST_REMOTE_CODE=false
LOCAL_TRAINING_MAX_STEPS=80
LOCAL_TRAINING_LEARNING_RATE=0.00005
LOCAL_TRAINING_LORA_R=16
LOCAL_TRAINING_LORA_ALPHA=32
LOCAL_TRAINING_LORA_DROPOUT=0.05
LOCAL_TRAINING_MAX_SEQ_LEN=512
LOCAL_TRAINING_FORCE_FP16_BASE=true
LOCAL_TRAINING_FORCE_GRADIENT_CHECKPOINTING_ON_SMALL_GPU=true
LOCAL_TRAINING_SAVE_EVERY_STEPS=200
LOCAL_TRAINING_GRADIENT_CHECKPOINTING=true
LOCAL_TRAINING_USE_AMP=false
LOCAL_TRAINING_BF16=false
LOCAL_TRAINING_ABORT_ON_NONFINITE=true
LOCAL_TRAINING_MAX_GRAD_NORM=0.5
LOCAL_TRAINING_MAX_GPU_MB=10240
LOCAL_TRAINING_MAX_CPU_MB=24000

# ------------------------------
# Workspace + memory
# ------------------------------
WORKSPACE_ROOT=../.workspace
MEMORY_DB_PATH=../.memory/memory.sqlite
WORKSPACE_MODULE_RUN_TIMEOUT_S=90

# ------------------------------
# Timeouts
# ------------------------------
RESOURCE_CALL_TIMEOUT_S=45
QA_CALL_TIMEOUT_S=180
ORCHESTRATOR_CALL_TIMEOUT_S=240
LLM_TIMEOUT_S=90
LLM_BACKEND_RETRY_ATTEMPTS=1
LLM_BACKEND_RETRY_BACKOFF_S=1.0
LLM_BACKEND_ERROR_COOLDOWN_S=300
LLM_BACKEND_QUOTA_COOLDOWN_S=1800

# ------------------------------
# Command Agent safety
# ------------------------------
COMMAND_ALLOWLIST=python,pytest,pip,uvicorn,git,docker
DOCKER_EXEC_DISABLED=true

# ------------------------------
# Dependency auto-install (pip)
# ------------------------------
AUTO_INSTALL_DEPS=true
PIP_INSTALL_TIMEOUT_S=6000

# ------------------------------
# Agent limits
# ------------------------------
AGENT_MAX_PER_TYPE=2
MAX_ORCHESTRATORS=1

# ------------------------------
# Web research / crawling
# ------------------------------
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_POOL_SIZE=2
WEB_SEARCH_MAX_RESULTS=6
WEB_FETCH_TOP_N=3
WEB_REQUEST_TIMEOUT_S=12
WEB_USER_AGENT=AgenticHiveBot/0.1
ORCH_SCALE_THRESHOLD=99
ORCH_QUERY_BATCH_SIZE=4

# ------------------------------
# Local reference projects
# ------------------------------
REFERENCE_PROJECT_EXCLUDE_DIRS=.git,node_modules,.venv,venv,__pycache__,.mypy_cache,.pytest_cache,dist,build
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------
# Code-learning signals
# ------------------------------
CODE_TRAINING_ENABLED=true
CODE_TRAINING_MAX_EXAMPLES_PER_RUN=8
CODE_TRAINING_MAX_CHARS=12000

# RLHF-style user feedback signals
FEEDBACK_TRAINING_ENABLED=true
LOCAL_TRAINING_FEEDBACK_WEIGHT=4

# ------------------------------
# Provider fallback chain
# ------------------------------
# Keep local-only by default while validating local stability.
# If you want automatic rescue by Gemini later, change to:
#   LLM_FALLBACK_TO_OPENAI=true
#   LLM_FALLBACK_BACKENDS=local,gemini
LLM_FALLBACK_TO_OPENAI=false
LLM_FALLBACK_BACKENDS=local
LLM_FALLBACK_MIN_CHARS=0

# ------------------------------
# Uploads
# ------------------------------
UPLOAD_MAX_MB=100
UPLOAD_CHUNK_SIZE_CHARS=1200
UPLOAD_CHUNK_OVERLAP_CHARS=120
UPLOAD_TRAINING_ENABLED=true
UPLOAD_TRAINING_MAX_EXAMPLES=80

# Helpful for CUDA fragmentation during training
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# RAG keeps local Q&A/code responses grounded in hive memory and current project files.
RAG_ENABLED=true
RAG_MEMORY_SCAN_LIMIT=350
RAG_MEMORY_LIMIT=8
RAG_PROJECT_FILE_LIMIT=10
RAG_MAX_CHARS=9000
RAG_MAX_FILE_BYTES=200000
RAG_SKIP_DIRS=.git,.workspace,.workspaces,.memory,node_modules,.venv,venv,__pycache__,.mypy_cache,.pytest_cache,dist,build,.next,coverage

# Purpose-specific local generation caps for RTX 3060-class GPUs.
LOCAL_LLM_QA_MAX_NEW_TOKENS=256
LOCAL_LLM_CODE_MAX_NEW_TOKENS=384
LOCAL_LLM_JSON_MAX_NEW_TOKENS=256
LOCAL_LLM_MAX_INPUT_TOKENS=3072
LOCAL_LLM_EMPTY_CACHE_AFTER_GENERATE=false
LOCAL_QA_WEB_RESEARCH_ENABLED=false
LOCAL_CODE_WEB_RESEARCH_ENABLED=false
